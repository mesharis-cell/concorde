// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Prisma v6 features
  binaryTargets = ["native"]
  // Enable advanced query optimization
  engineType    = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AdminRole {
  SUPER
  STANDARD
}

enum ActivityCategory {
  TRANSPORT
  HOSPITALITY
  EXPERIENCE
  MEETING
  OTHER
}

enum MessageType {
  WELCOME
  ASSIGNMENT
  ACTIVITY_UPDATE
  ANNOUNCEMENT
  OTP_VERIFICATION
}

enum TemplateType {
  COMMUNICATION
  AUTHENTICATION
}

enum TemplateCategory {
  WELCOME
  ASSIGNMENT
  ACTIVITY_UPDATE
  ANNOUNCEMENT
  OTP_VERIFICATION
  CUSTOM
}

enum RecipientType {
  INDIVIDUAL
  GROUP
  ALL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  ASSIGN
  UNASSIGN
}

// ============================================================================
// MODELS
// ============================================================================

model Event {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  shortName String

  location  Json // { city, country, venue, timezone }
  dateRange Json // { start: DateTime, end: DateTime }
  config    Json // { micrositeUrl, registrationOpen }

  // Singapore Phase 2 additions
  hotelConfig     Json? // Hotel inventory and configuration
  roomDrops       Json? // Room drop packages configuration
  guestCategories Json? // Guest tier categories configuration
  carConfig       Json? // Transport/car inventory and configuration
  termsConditions String? // HTML from TipTap editor  
  privacyPolicy   String? // HTML from TipTap editor

  // Dynamic Registration Form Configuration
  registrationFormConfig Json? // Dynamic multi-step form configuration with validation rules

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  groups      Group[]
  activities  Activity[]
  users       User[]
  otps        UserOTP[]
  messages    Message[]
  adminEvents AdminEvent[]
  communicationLogs CommunicationLog[]
  userActivityExclusions UserActivityExclusion[]
  emailTemplates EmailTemplate[]
  auditTrails AuditTrail[]
  roomAssignments RoomAssignment[]
  hotels      Hotel[]
  roomTypes   RoomType[]

  @@map("events")
}

model Group {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String    @db.ObjectId
  name        String
  description String
  memberCount Int       @default(0)
  active      Boolean   @default(true)
  deleted     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  
  // Many-to-many with activities (MongoDB array approach)
  activityIds String[]   @db.ObjectId
  
  // Transport assignments - default cars for group members
  carNumbers String[] @default([]) // ["car-1", "car-2"] - inherited by all group members

  // Relations
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activities Activity[] @relation(fields: [activityIds], references: [id])
  communicationLogs CommunicationLog[]
  userActivityExclusions UserActivityExclusion[]

  @@map("groups")
}

model Activity {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  eventId String  @db.ObjectId
  groupIds String[] @db.ObjectId  // Multiple groups per activity

  // Scheduling (required)
  title         String
  description   String?
  startDateTime DateTime
  endDateTime   DateTime

  // Display properties
  thumbnail String? // S3 URL
  category  ActivityCategory @default(OTHER)

  // Location (optional)
  location Json? // { name, address, mapLink }

  // Content
  content Json // { html: string }
  dressCode String? // Dress code for the activity

  // Capacity management
  capacity         Int?      // null = unlimited capacity
  currentAttendees Int       @default(0) // Auto-computed from assignments

  // Timing details for structured scheduling
  timingTable Json[] // [{ enabled: Boolean, time: String, description: String, location?: String }]

  // Import/content management
  importKey      String? // Stable key for content updates after nightly imports

  active         Boolean   @default(true)
  deleted        Boolean   @default(false)
  createdBy      String    @db.ObjectId
  lastModifiedBy String?   @db.ObjectId // Optional for creation
  lastModifiedAt DateTime? // Track modification time
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  event                 Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groups                Group[] @relation(fields: [groupIds], references: [id])
  createdByAdmin        Admin   @relation("ActivityCreator", fields: [createdBy], references: [id])
  lastModifiedByAdmin   Admin?  @relation("ActivityModifier", fields: [lastModifiedBy], references: [id])
  userExclusions        UserActivityExclusion[]

  // Prisma v6 optimized indexes for timeline queries
  @@index([groupIds, startDateTime])
  @@index([eventId, active, deleted])
  @@index([groupIds, active, deleted])
  @@index([createdBy])
  @@index([lastModifiedBy])
  @@index([capacity, currentAttendees]) // For capacity monitoring
  @@index([importKey]) // For content update lookups
  @@map("activities")
}

model User {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId  String   @db.ObjectId
  groupIds String[] @db.ObjectId // Multiple group assignments

  // Profile
  profile Json // { email, firstName, lastName, phone, preferredFirstName, preferredLastName }
  
  // Admin-managed structured tickets  
  tickets Json[] @default([]) // Array of structured tickets: [{ name: string, number: string, valid: boolean }]

  // Authentication - 7-day JWT sessions only (OTPs are handled separately)

  // Communication preferences
  communication Json // { emailOptIn, whatsappOptIn }

  // Travel & accommodation details
  flight               Json? // { inbound: { departureFrom, departureDate, departureTime, departureTerminal, flightNumber, airline, arrivalDate, arrivalTime, arrivalToAirport, arrivalToTerminal }, outbound: { departureFrom, departureDate, departureTime, departureTerminal, flightNumber, airline, arrivalDate, arrivalTime, arrivalToAirport, arrivalToTerminal } }
  accommodation        Json? // { required, hotel, checkIn, checkOut, hotelNotes, doubleOccupancy: { enabled, guestType, guestName, guestRelation }, twinOccupancy: { enabled, guestType }, earlyCheckIn, lateCheckOut, visaBookingRequired }
  transferRequirements Boolean @default(false)
  
  // Enhanced transfer requirements - separate fields for compatibility
  gpTransfersRequired Boolean @default(false)      // Grand Prix transfers from Mondrian
  eventTransfersRequired Boolean @default(false)   // General event transfers

  // Requirements - Enhanced YES/NO pattern
  requirements Json? // { medical: { enabled, details }, dietary: { enabled, details }, allergiesIntolerances: { enabled, details }, accessibility: { enabled, details }, otherComments }

  // Merchandise
  merchandiseSize Json? // { shirt, jacket, hat }

  // Emergency contact
  emergencyContact Json? // { name, relationship, phone, email }

  // Assignment status (now supports multiple groups)
  assigned   Boolean   @default(false) // true if assigned to any group
  assignedAt DateTime? // last assignment date
  assignedBy String?   @db.ObjectId // last admin who assigned
  
  // Notification status
  groupAssignmentNotified Boolean @default(false)
  groupAssignmentNotifiedAt DateTime?

  // Hotel & room management
  guestCategory String? // Admin-assigned guest tier (VIP, Standard, etc.)
  roomDropAssigned String? // ID of assigned room drop package
  hotelId String? @db.ObjectId // Reference to assigned hotel
  
  // Transport assignments - individual car overrides
  carNumbers String[] @default([]) // [] = inherit from group, ["car-5"] = individual override

  // Report-specific notes
  arrivalNotes String? // Notes specific to arrival logistics
  departureNotes String? // Notes specific to departure logistics
  masterGuestNotes String? // General notes for master guest report
  carAssignmentNotes String? // Notes specific to car assignments

  // Status & timestamps
  active       Boolean   @default(true)
  registeredAt DateTime  @default(now())
  lastLoginAt  DateTime?
  updatedAt    DateTime  @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hotel Hotel? @relation("UserHotel", fields: [hotelId], references: [id], onDelete: SetNull)
  otps UserOTP[]
  communicationLogs CommunicationLog[]
  activityExclusions UserActivityExclusion[]
  emailTracking EmailTracking[]
  roomAssignments RoomAssignment[]

  // Prisma v6 optimized indexes
  @@index([eventId, active])
  @@index([eventId, assigned])
  @@index([groupIds])
  @@index([groupAssignmentNotified])
  @@map("users")
}

model UserOTP {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  eventId  String   @db.ObjectId
  
  // OTP details
  otpCode    String   // 4-digit OTP
  channel    String   // "email" | "sms" (extensible for future channels)
  
  // Rate limiting & security
  attempts   Int      @default(0)
  verified   Boolean  @default(false)
  
  // Expiry (10 minutes)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  verifiedAt DateTime?
  
  // User context
  userEmail String   // Store email for quick lookup
  
  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Indexes for performance and rate limiting
  @@index([userId, createdAt])
  @@index([userEmail, createdAt])
  @@index([otpCode, verified])
  @@index([expiresAt])
  @@map("user_otps")
}

model CommunicationLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  eventId   String   @db.ObjectId
  groupId   String?  @db.ObjectId
  adminId   String   @db.ObjectId
  
  // Communication details
  type        String   // "email" | "whatsapp"
  channel     String   // "email" | "whatsapp" | "sms"
  purpose     String   // "group_assignment" | "event_reminder" | "custom" | "announcement"
  subject     String?
  content     Json     // { html?, text?, templateId?, variables? }
  
  // Recipients (for bulk sends)
  recipientType String // "single" | "group" | "event" | "custom"
  recipientIds  String[] @db.ObjectId // Array of user IDs for bulk sends
  
  // Status tracking
  status      String   // "sent" | "delivered" | "failed" | "pending"
  sentAt      DateTime @default(now())
  deliveredAt DateTime?
  failedAt    DateTime?
  error       String?
  
  // Metadata
  metadata    Json?    // { messageId?, trackingId?, cost?, etc. }
  
  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([eventId])
  @@index([groupId])
  @@index([adminId])
  @@index([type, status])
  @@index([purpose])
  @@index([sentAt])
  @@map("communication_logs")
}

model Admin {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  firstName    String
  lastName     String
  passwordHash String
  role         AdminRole @default(STANDARD)
  lastLoginAt  DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  adminEvents           AdminEvent[]
  communicationLogs     CommunicationLog[]
  createdActivities     Activity[] @relation("ActivityCreator")
  lastModifiedActivities Activity[] @relation("ActivityModifier")
  createdExclusions     UserActivityExclusion[] @relation("ExclusionCreator")
  createdTemplates      EmailTemplate[] @relation("TemplateCreator")
  auditTrails           AuditTrail[]
  roomAssignments       RoomAssignment[] @relation("RoomAssigner")
  roomUpdates           RoomAssignment[] @relation("RoomUpdater")

  @@map("admins")
}

// Join table for Admin-Event many-to-many relationship
model AdminEvent {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  adminId String @db.ObjectId
  eventId String @db.ObjectId

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([adminId, eventId])
  @@map("admin_events")
}

model UserActivityExclusion {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  activityId String @db.ObjectId
  groupId    String @db.ObjectId // For context and validation
  eventId    String @db.ObjectId // For event isolation
  
  // Metadata
  excludedBy String   @db.ObjectId // Admin who created the exclusion
  reason     String?  // Optional reason for exclusion
  createdAt  DateTime @default(now())
  
  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  admin    Admin    @relation("ExclusionCreator", fields: [excludedBy], references: [id])
  
  // Ensure unique exclusions per user-activity pair
  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@index([groupId])
  @@index([eventId])
  @@map("user_activity_exclusions")
}

model EmailTemplate {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId  String   @db.ObjectId
  name     String   // Template name (unique per event)
  type     TemplateType // 'COMMUNICATION' | 'AUTHENTICATION'
  category TemplateCategory // 'WELCOME' | 'ASSIGNMENT' | etc.
  
  // Email content
  subject  String   // Email subject with variable placeholders
  html     String   // Complete HTML template
  
  // Template metadata
  requiredVariables String[] // Variable names needed for template
  active            Boolean @default(true)
  createdBy         String  @db.ObjectId // Super admin who created template
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByAdmin    Admin    @relation("TemplateCreator", fields: [createdBy], references: [id])
  messages          Message[]
  
  // Unique template name per event
  @@unique([eventId, name])
  @@index([eventId, type])
  @@index([eventId, category])
  @@index([createdBy])
  @@map("email_templates")
}

model EmailTracking {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId  String   @db.ObjectId
  userId     String   @db.ObjectId
  
  // Tracking details
  trackingUrl String   // Generated unique tracking URL
  opened      Boolean @default(false)
  openedAt    DateTime?
  userAgent   String?  // Email client info
  ipAddress   String?
  
  // Relations
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Unique tracking per message-user pair and unique tracking URL
  @@unique([messageId, userId])
  @@unique([trackingUrl])
  @@index([messageId])
  @@index([userId])
  @@map("email_tracking")
}

model Message {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  eventId    String      @db.ObjectId
  templateId String?     @db.ObjectId // Reference to EmailTemplate (optional for backward compatibility)
  type       MessageType

  // Email content (legacy fields - template takes precedence)
  emailSubject String?
  emailContent String? // HTML

  // WhatsApp content (legacy)
  whatsappTemplate  String?
  templateVariables Json? // Variables used for template substitution

  // Recipients
  recipientType RecipientType
  recipientIds  String[]      @db.ObjectId // User or Group IDs

  // Enhanced delivery tracking per user
  deliveries Json[] // [{ user, email: {sent, sentAt, opened, openedAt, delivered, deliveredAt, error}, whatsapp: {...} }]

  // Monitoring
  monitoringEmailSent Boolean @default(false)
  
  sentBy    String   @db.ObjectId // Admin ID
  createdAt DateTime @default(now())
  status    String   @default("draft") // 'draft' | 'sending' | 'sent' | 'failed'

  // Relations
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template      EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  emailTracking EmailTracking[]

  @@index([eventId])
  @@index([templateId])
  @@index([sentBy])
  @@index([status])
  @@map("messages")
}

model Migration {
  id    String   @id @default(auto()) @map("_id") @db.ObjectId
  name  String   @unique
  batch Int
  runAt DateTime @default(now())

  @@index([batch])
  @@map("migrations")
}

model RoomAssignment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  eventId   String   @db.ObjectId
  hotelId   String   @db.ObjectId // Reference to hotel
  roomTypeId String  @db.ObjectId // Reference to room type

  // Operational fields
  assignedBy  String   @db.ObjectId // Admin who assigned the room
  assignedAt  DateTime @default(now())
  updatedBy   String   @db.ObjectId
  updatedAt   DateTime @updatedAt
  hotelNotes  String?  // Notes from hotel
  billingNotes String? // Billing information
  bookingConfirmationNumber String? // Hotel booking reference

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  assignedByAdmin Admin @relation("RoomAssigner", fields: [assignedBy], references: [id])
  updatedByAdmin Admin @relation("RoomUpdater", fields: [updatedBy], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([assignedBy])
  @@index([updatedBy])
  @@map("room_assignments")
}

model Hotel {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @db.ObjectId
  name        String
  isDefault   Boolean  @default(false)
  checkInTime String   // "15:00"
  checkOutTime String  // "11:00"
  address     String?
  phone       String?
  email       String?
  website     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomTypes   RoomType[]
  users       User[]       @relation("UserHotel")
  roomAssignments RoomAssignment[]

  @@index([eventId])
  @@index([eventId, active])
  @@map("hotels")
}

model RoomType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @db.ObjectId
  hotelId     String   @db.ObjectId
  name        String   // "Deluxe Twin", "Club Suite", etc.
  description String?
  maxOccupancy Int     @default(2)
  amenities   String[] // ["WiFi", "Air Conditioning", "Mini Bar"]
  basePrice   Float?   // Optional pricing information
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hotel       Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomAssignments RoomAssignment[]

  @@index([eventId])
  @@index([hotelId])
  @@index([eventId, active])
  @@index([hotelId, active])
  @@map("room_types")
}

model AuditTrail {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId

  // What was changed
  action      AuditAction // CREATE, UPDATE, DELETE, etc.
  resourceType String     // "User", "Activity", "Group", "Event", etc.
  resourceId  String      @db.ObjectId // ID of the affected resource

  // Context information
  eventId     String?     @db.ObjectId // Event context (if applicable)

  // Who made the change
  performedBy String      @db.ObjectId // Admin ID who performed the action
  performedByType String  // "ADMIN" or "SYSTEM" (for automated actions)

  // Change details
  changes     Json?       // Before/after values for updates, full object for creates/deletes
  summary     String      // Human-readable summary of what happened

  // Additional context
  metadata    Json?       // Additional context like IP address, user agent, bulk operation details, etc.

  // Timestamps
  createdAt   DateTime    @default(now())

  // Relations
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  admin       Admin       @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  // Indexes for efficient querying
  @@index([eventId, createdAt])
  @@index([performedBy, createdAt])
  @@index([resourceType, createdAt])
  @@index([resourceId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt]) // For timeline ordering
  @@map("audit_trails")
}
