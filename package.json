{
  "name": "event-companion-backend",
  "version": "1.0.0",
  "description": "Event Concierge Platform Backend API",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target=bun",
    "format": "bun run prisma:format",
    "lint": "bun run prisma:validate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "typecheck": "bun run type-check",
    "predeploy": "bun run format && bun run lint && bun run typecheck",
    "type-check": "tsc --noEmit",
    "setup": "bun run prisma:generate && bun run prisma:push && bun scripts/setup.js",
    "reset-db": "bun run prisma:push --force-reset",
    "seed:demo": "bun scripts/seed-demo.ts",
    "demo:reset": "bun scripts/seed-demo.ts --force-reset",
    "demo:setup": "bun run prisma:generate && bun run prisma:push && bun scripts/setup.js",
    "demo:black:seed": "bun scripts/seed-black-demo.ts",
    "migrate": "bun scripts/migrate.ts up",
    "migrate:rollback": "bun scripts/migrate.ts down",
    "migrate:status": "bun scripts/migrate.ts status",
    "make:migration": "bun scripts/make-migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/client-ses": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@hono/node-server": "^1.19.0",
    "@hono/swagger-ui": "^0.2.0",
    "@hono/zod-openapi": "^0.9.0",
    "@prisma/client": "6.14.0",
    "@types/node": "^24.3.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.0",
    "exceljs": "^4.4.0",
    "hono": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mongodb": "^6.19.0",
    "prisma": "6.14.0",
    "resend": "^4.0.0",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.22"
}
