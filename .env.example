# Core runtime
DATABASE_URL="mongodb://localhost:27017/savvio-concorde-demo"
JWT_SECRET="replace-with-long-random-secret"
JWT_EXPIRES_IN="7d"
MAGIC_LINK_EXPIRES_IN="24h"
NODE_ENV="development"
PORT="3001"
APP_URL="https://demo.savvio.digital"
FRONTEND_URL="https://demo.savvio.digital"
DEMO_MODE="true"
DEMO_OTP_MODE="true"
DEMO_OTP_FIXED_CODE="1234"

# Storage & providers
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-s3-bucket"
SES_FROM_EMAIL="no-reply@savvio.digital"
SES_FROM_NAME="Savvio Concorde"
RESEND_API_KEY="re_replace_me"
EMAIL_PROVIDER="resend"
TWILIO_ENABLED="false"
TWILIO_ACCOUNT_SID="replace-if-needed"
TWILIO_AUTH_TOKEN="replace-if-needed"
TWILIO_WHATSAPP_FROM="whatsapp:+10000000000"

# Wallet / PassKit
PASSKIT_API_KEY="pk_test_replace_me"
PASSKIT_TEMPLATE_ID="template_replace_me"
PASSKIT_ISSUER_ID="issuer_replace_me"
PASSKIT_BASE_URL="https://api.passkit.com"
WALLET_PASS_TTL_HOURS="24"

# Demo setup/admin identities
DEMO_SUPERADMIN_EMAIL="demo.owner@savvio.digital"
DEMO_SUPERADMIN_PASSWORD="DemoOwner123!"
DEMO_SUPERADMIN_FIRST_NAME="Demo"
DEMO_SUPERADMIN_LAST_NAME="Owner"
DEMO_STANDARD_ADMIN_EMAIL="demo.ops@savvio.digital"
DEMO_STANDARD_ADMIN_PASSWORD="DemoOps123!"

# Optional helpers used by parts of the app
DEFAULT_EVENT_ID=""
